// 360-engage-website on Cloudflare Workers: dist/ plus the site-lock edge function (cloudflare/worker.mjs).
// Deploy: npm run build && cd cloudflare && wrangler deploy. Secret: wrangler secret put SITE_LOCK_PASSWORD.
{
  "name": "360-engage-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Netlify Forms replacement (cloudflare/forms.js): the recipients Netlify notified. RESEND_API_KEY is a Worker secret.
  "d1_databases": [{ "binding": "FORMS_DB", "database_name": "forms", "database_id": "ad2881b0-2793-4f4b-96c6-1f553f56a209" }],
  "vars": {
    "FORMS_SITE": "360-engage-website",
    "FORMS_NOTIFY": "Graham@glasshouse-group.co.uk,mokingjill@gmail.com,shekhar.dewan@gmail.com,sirvineyvr@gmail.com,wil@glasshouse-group.co.uk",
    "FORMS_FROM": "Website forms <forms@aiforward.ca>"
  },
  "observability": { "enabled": true }
}
