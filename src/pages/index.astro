---
import Layout from '../layouts/Layout.astro';
---

<Layout title="360ENGAGE | Corporate">
    <!-- Hero Section -->
    <section class="hero" style="padding-top: 100px; background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(241,245,249,0.5) 100%);">
        <div class="container" style="text-align: center; position: relative; z-index: 10;">
            <div class="tagline" style="justify-content: center;">The Million-Dollar Blind Spot</div>
            <h1 style="max-width: 1000px; margin: 0 auto 2rem;">TURN INVISIBLE FANS INTO MEASURABLE REVENUE</h1>
            <p style="max-width: 700px; margin: 0 auto 3rem;">The infrastructure platform enabling sports properties to capture zero-party data, drive in-seat sales, and build proprietary engagement moats.</p>
            
            <a href="/demo/" class="cta-button">See How It Works</a>
            <a href="#problem" style="display: inline-block; margin-left: 1rem; color: var(--text-secondary); text-decoration: none; font-weight: 500;">Learn More &rarr;</a>
        </div>
    </section>

    <!-- The Problem (Split Layout) -->
    <section id="problem" class="section">
        <div class="container split-layout">
            <div>
                <div class="tagline">The Problem</div>
                <h2 style="font-size: clamp(2rem, 4vw, 3.5rem); margin-bottom: 1.5rem; letter-spacing: -0.02em;">76% of Global Sports Fans are Commercially Invisible.</h2>
                <p style="font-size: 1.25rem; color: var(--text-secondary); line-height: 1.6;">Rights holders reach billions, but on average, they only "know" 24% of their audience. This is the "Million-Dollar Blind Spot"—a systemic revenue leakage costing the average sports property between $1M and $5M annually.</p>
            </div>
            <div class="image-stack">
                <img src="/assets/alfonso-scarpa-e12EkMYv44U-unsplash.jpg" alt="Stadium Crowd" class="img-main" onerror="this.src='https://images.unsplash.com/photo-1522778119026-d647f0596c20?auto=format&fit=crop&q=80&w=800';">
                <img src="/assets/thomas-serer-alUSb8lCE5s-unsplash.jpg" alt="Fan Interaction" class="img-accent" onerror="this.src='https://images.unsplash.com/photo-1489944440615-453fc2b6a9a9?auto=format&fit=crop&q=80&w=600';">
            </div>
        </div>
    </section>

    <!-- The Solution (Dark Band) -->
    <section id="solution" class="section" style="background: #0f172a; color: white;">
        <div class="container" style="max-width: 1000px; text-align: center;">
            <div class="tagline" style="justify-content: center; color: #3b82f6;">The Solution</div>
            <h2 style="font-size: clamp(2.5rem, 5vw, 4.5rem); margin-bottom: 2rem; color: white; letter-spacing: -0.02em;">Infrastructure, Not a Feature.</h2>
            <p style="font-size: 1.5rem; color: #94a3b8; line-height: 1.6;">360engage replaces fragmented point solutions with a single "spine" that handles the complete fan journey. One conversation activates multiple revenue streams while building a proprietary data moat.</p>
        </div>
    </section>

    <!-- How It Works (Step-by-Step Flow) -->
    <section id="how-it-works" class="section">
        <div class="container">
            <div style="text-align: center; margin-bottom: 4rem;">
                <div class="tagline" style="justify-content: center;">How It Works</div>
                <h2 style="font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.02em;">The Intelligence Engine</h2>
            </div>
            <div class="grid-3">
                <div class="glass-card step-card">
                    <span class="step-number">01</span>
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Frictionless Capture</h3>
                    <p style="color: var(--text-secondary); line-height: 1.6;">Fans scan a QR code on a seat or concourse to open a Progressive Web App (PWA) chat. Zero app downloads, zero account creation friction.</p>
                </div>
                <div class="glass-card step-card" style="border-top-color: #3b82f6;">
                    <span class="step-number">02</span>
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">AI-Driven Engagement</h3>
                    <p style="color: var(--text-secondary); line-height: 1.6;">Our Conversational AI instantly answers questions, resolves ticketing logistics, and organically identifies opportunities for in-seat ordering or merchandising.</p>
                </div>
                <div class="glass-card step-card" style="border-top-color: #0f172a;">
                    <span class="step-number">03</span>
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">The Data Moat</h3>
                    <p style="color: var(--text-secondary); line-height: 1.6;">Every interaction enriches your central Fan Intelligence Graph, converting previously "anonymous" ticket-holders into known, monetizable profiles.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Platform Features Grid -->
    <section id="features" class="section" style="background: rgba(241, 245, 249, 0.4); border-top: 1px solid var(--border);">
        <div class="container">
            <div style="max-width: 600px; margin-bottom: 3rem;">
                <div class="tagline">Platform Features</div>
                <h2 style="font-size: clamp(2rem, 3.5vw, 2.5rem); letter-spacing: -0.02em;">Activating the Spine</h2>
            </div>
            <div class="grid-4">
                <div class="glass-card" style="padding: 2rem;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #0f172a;">Smart Support Deflection</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">Automate tier-1 queries on match days, drastically reducing operational overhead and call-center volume.</p>
                </div>
                <div class="glass-card" style="padding: 2rem;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #0f172a;">In-Seat Ordering</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">Drive massive F&B uplift by allowing fans to order directly through their chat interface without missing a play.</p>
                </div>
                <div class="glass-card" style="padding: 2rem;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #0f172a;">Sponsorship Activation</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">Monetize attention with non-intrusive, conversational sponsorships and zero-party data collection campaigns.</p>
                </div>
                <div class="glass-card" style="padding: 2rem;">
                    <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem; color: #0f172a;">Impact Tracking</h3>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">Integrate verified environmental and ESG metrics directly into the fan journey to foster deeper loyalty.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- The ROI (Card Grid) -->
    <section id="roi" class="section">
        <div class="container">
            <div style="text-align: center; margin-bottom: 4rem;">
                <div class="tagline" style="justify-content: center;">The ROI</div>
                <h2 style="font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.02em;">Measurable Impact at Scale</h2>
            </div>
            <div class="grid-3">
                <div class="glass-card" style="padding: 2.5rem; background: #ffffff;">
                    <div style="font-size: 2.5rem; margin-bottom: 1.5rem;">📊</div>
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">4x Higher Conversion</h3>
                    <p style="color: var(--text-secondary); line-height: 1.6;">AI-driven chats convert at <strong>12.3%</strong> vs. 3.1% for traditional digital channels.</p>
                </div>
                <div class="glass-card" style="padding: 2.5rem; background: #ffffff;">
                    <div style="font-size: 2.5rem; margin-bottom: 1.5rem;">⚡</div>
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Frictionless Entry</h3>
                    <p style="color: var(--text-secondary); line-height: 1.6;">Progressive Web App (PWA) micropages yield <strong>36% higher conversions</strong> than native apps by removing download barriers.</p>
                </div>
                <div class="glass-card" style="padding: 2.5rem; background: #ffffff;">
                    <div style="font-size: 2.5rem; margin-bottom: 1.5rem;">💷</div>
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Direct Impact</h3>
                    <p style="color: var(--text-secondary); line-height: 1.6;">Achieve up to <strong>£100,000+</strong> in incremental revenue per match by Phase 5 of rollout.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Now Urgency Band -->
    <section id="why-now" class="section" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white; border-top: 1px solid rgba(255,255,255,0.1);">
        <div class="container" style="text-align: center; max-width: 900px;">
            <div class="tagline" style="justify-content: center; color: var(--accent);">Why Now?</div>
                <h2 style="font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1.5rem; color: white;">The Broadcast Era is Evolving</h2>
                <p style="font-size: 1.25rem; color: #94a3b8; line-height: 1.7; margin-bottom: 2.5rem;">
                    Clubs that rely entirely on broadcast revenue and ticketing aggregators are flying blind. As direct-to-fan monetization becomes the primary growth lever in global sports, owning the fan relationship and data is no longer optional—it is the ultimate strategic imperative for any modern sports property or investor.
                </p>
            <a href="#contact" class="cta-button" style="background: white; color: #0f172a; padding: 1rem 2.5rem;">Speak with the Founders</a>
        </div>
    </section>

    <!-- The Team -->
    <section id="team" class="section" style="background: var(--bg-surface);">
        <div class="container">
            <div class="tagline">The Glasshouse Group</div>
            <h2 style="font-size: clamp(2rem, 4vw, 3rem); max-width: 800px; margin-bottom: 4rem; letter-spacing: -0.02em;">We build the infrastructure for the next generation of fan relationships.</h2>
            
            <div class="team-grid">
                <div class="team-card">
                    <img src="/image/William Block.png" alt="William Block" class="team-photo glass-card" style="padding:0;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="team-photo glass-card" style="display:none;">WB</div>
                    <h4 style="font-size: 1.25rem; margin-bottom: 0.25rem;">William Block</h4>
                    <p style="color: var(--accent); font-weight: 600; font-size: 0.875rem;">Co-Founder</p>
                </div>
                <div class="team-card">
                    <img src="/image/Daniel Davis.png" alt="Daniel Davis" class="team-photo glass-card" style="padding:0;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="team-photo glass-card" style="display:none;">DD</div>
                    <h4 style="font-size: 1.25rem; margin-bottom: 0.25rem;">Daniel Davis</h4>
                    <p style="color: var(--accent); font-weight: 600; font-size: 0.875rem;">Co-Founder & CFO</p>
                </div>
                <div class="team-card">
                    <img src="/image/Simon Moseley.png" alt="Simon Moseley" class="team-photo glass-card" style="padding:0;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="team-photo glass-card" style="display:none;">SM</div>
                    <h4 style="font-size: 1.25rem; margin-bottom: 0.25rem;">Simon Moseley</h4>
                    <p style="color: var(--accent); font-weight: 600; font-size: 0.875rem;">Co-Founder</p>
                </div>
                <div class="team-card">
                    <img src="/image/Graham Warren.png" alt="Graham Warren" class="team-photo glass-card" style="padding:0;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="team-photo glass-card" style="display:none;">GW</div>
                    <h4 style="font-size: 1.25rem; margin-bottom: 0.25rem;">Graham Warren</h4>
                    <p style="color: var(--accent); font-weight: 600; font-size: 0.875rem;">Co-Founder</p>
                </div>
                <div class="team-card">
                    <img src="/image/Stewart Irvine.png" alt="Stewart Irvine" class="team-photo glass-card" style="padding:0;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="team-photo glass-card" style="display:none;">SI</div>
                    <h4 style="font-size: 1.25rem; margin-bottom: 0.25rem;">Stewart Irvine</h4>
                    <p style="color: var(--accent); font-weight: 600; font-size: 0.875rem;">Co-Founder & CTO</p>
                </div>
                <div class="team-card">
                    <img src="/image/Ben Prior.png" alt="Ben Prior" class="team-photo glass-card" style="padding:0;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="team-photo glass-card" style="display:none;">BP</div>
                    <h4 style="font-size: 1.25rem; margin-bottom: 0.25rem;">Ben Prior</h4>
                    <p style="color: var(--accent); font-weight: 600; font-size: 0.875rem;">Creative Director</p>
                </div>
            </div>
        </div>
    </section>
</Layout>
