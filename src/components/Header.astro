---
interface Props {
  isDemo?: boolean;
}

const { isDemo = false } = Astro.props;
---

<nav class="global-nav">
  <a href="/" class="brand-logo">
      360ENGAGE
  </a>
  <div class="nav-links">
      {isDemo ? (
          <>
              <a href="/" class="nav-link">&larr; Back to Corporate Homepage</a>
              <a href="#investment-thesis" class="nav-link">Investment Thesis</a>
          </>
      ) : (
          <>
              <a href="#the-gap" class="nav-link">Mind the Gap</a>
              <a href="#the-platform" class="nav-link">The Platform</a>
              <a href="#fan-intelligence" class="nav-link">Fan Intelligence</a>
              <a href="#our-team" class="nav-link">Our Team</a>
              <a href="/demo/" class="cta-button" style="padding: 0.75rem 1.5rem; font-size: 0.9rem; margin-right: 0.5rem; background: transparent; border: 1px solid var(--accent); color: var(--accent);">Explore Demo</a>
              <a href="#talk-to-us" class="cta-button" style="padding: 0.75rem 1.5rem; font-size: 0.9rem; background: var(--accent); color: #ffffff;">Talk to Us</a>
          </>
      )}
  </div>
</nav>

<style>
  .brand-logo {
      font-family: 'Outfit', sans-serif;
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--accent);
      text-decoration: none;
      letter-spacing: -0.05em;
  }
</style>
