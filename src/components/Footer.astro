---
interface Props {
  isDemo?: boolean;
}

const { isDemo = false } = Astro.props;
---

{isDemo ? (
  <div class="citations-bar">
      <div class="container" style="max-width: 1200px; margin: 0 auto;">
          <strong>Methodology & Citations:</strong> This investment brief synthesizes audited industry data across
          macroeconomics, behavioral architecture, and B2B M&A valuations. Figures reflect verified enterprise
          modeling from leading authorities: The <em>€665K friction penalty</em> (PickEat Stadium Concourse Modeling);
          <em>77% App Deletion</em> (BlueThrone Engagement Metrics); <em>2.5x LTV Multiplier</em> (Frontiers in Sports
          ML Valuation); <em>11,000 Hours Deflected & $232k Incremental Revenue</em> (Satisfi Labs Astros Case Study);
          <em>24% Anonymous Fan Index</em> (Dizplai); and the <em>$130 Billion Tech TAM</em> (Morgan Stanley
          Research). A fully annotated document is available in the data room.
      </div>
  </div>
) : (
  <footer id="footer" class="corporate-footer" style="padding: 3rem 0; background: var(--bg-surface); border-top: 1px solid var(--border);">
      <div class="container" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
              <img src="/images/360engage-logo.png" alt="360ENGAGE Logo" style="height: 32px; object-fit: contain;">
              <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.5rem; margin: 0; color: #0f172a; letter-spacing: -0.05em;">360ENGAGE</h3>
          </div>
          <p style="color: var(--text-secondary); margin-bottom: 2rem;">The Fan Intelligence Platform for professional sports clubs.</p>
          
          <div style="display: flex; gap: 2rem; margin-bottom: 2rem; flex-wrap: wrap; justify-content: center;">
              <span style="color: var(--text-secondary); font-size: 0.9rem;">
                  <strong style="color: #0f172a;">UK:</strong> Graham Warren — <a href="mailto:Graham@glasshouse-group.co.uk" style="color: var(--accent); text-decoration: none;">Graham@glasshouse-group.co.uk</a>
              </span>
              <span style="color: var(--text-secondary); font-size: 0.9rem;">
                  <strong style="color: #0f172a;">Global:</strong> Will Block — <a href="mailto:wil@glasshouse-group.co.uk" style="color: var(--accent); text-decoration: none;">wil@glasshouse-group.co.uk</a>
              </span>
          </div>

          <div style="font-size: 0.85rem; color: var(--text-secondary);">
              &copy; 2026 Glasshouse Engage Inc. | <a href="https://360engage.ai" style="color: var(--text-secondary); text-decoration: none;">360engage.ai</a>
          </div>
      </div>
  </footer>
)}
